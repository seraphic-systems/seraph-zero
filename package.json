{
  "name": "seraph-sites",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:components": "vite --config vite.components.config.ts",
    "dev:fixtures": "vite --mode fixtures",
    "dev:seraphic": "vite",
    "build": "npm run typecheck && node --experimental-strip-types scripts/build.ts",
    "build:production": "node --experimental-strip-types scripts/build-production.ts",
    "deploy:production": "node --experimental-strip-types scripts/deploy-cloudflare.ts production",
    "deploy:preview": "node --experimental-strip-types scripts/deploy-cloudflare.ts preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "create:record": "node --experimental-strip-types scripts/create-record.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
