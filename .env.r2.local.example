# Copy to .env.r2.local and fill in locally. This real file is ignored by Git.
# Use R2 S3 credentials, not a general Cloudflare bearer API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seraph-music-fragments
# Only needed for an EU or FedRAMP jurisdiction bucket:
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
